# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Comma-separated list of allowed Telegram user IDs
# e.g., ALLOWED_TELEGRAM_USER_IDS=12345678,87654321
ALLOWED_TELEGRAM_USER_IDS=

# Comma-separated list of allowed root directories for the bot to navigate and run agents
# e.g., ALLOWED_ROOT_DIRS=~/,~/projects
ALLOWED_ROOT_DIRS=~/

# Directory where session logs will be stored
SESSION_LOG_DIR=~/.agents-on-hand/sessions
